# Copy to .env and edit. Never commit .env.

# --- Release ---
# Collector image version from ghcr.io/andyg-0/netmonx-collector. Pin a release (e.g. 0.1.0);
# "latest" is the newest stable release, "edge" is the main branch.
NETMONX_VERSION=0.1.0

# --- Host ---
TZ=America/Chicago
# Owner of secrets/router_key on the host (run `id -u` and `id -g`).
HOST_UID=1000
HOST_GID=1000

# --- Router (asus-collector) ---
ROUTER_HOST=192.168.50.1
ROUTER_PORT=22
# The router's admin username (same as the web UI login).
ROUTER_USER=admin
# Optional: a known_hosts file mounted into the container to verify the router's host key.
ROUTER_KNOWN_HOSTS=
# Pinged from the router every FAST_INTERVAL. The first one is also traced.
ROUTER_PING_TARGETS=1.1.1.1,8.8.8.8
# IPv6 targets, pinged with ping6 only when IPv6 is on in the router. "none" turns them off.
ROUTER_PING6_TARGETS=2606:4700:4700::1111,2001:4860:4860::8888
PING_COUNT=5
# "auto" uses the WAN gateway (or first ISP hop behind a modem), "none", or an IP.
ISP_HOP=auto
# "auto" finds AiMesh nodes from the main router, "none", or a comma list of IPs.
MESH_NODES=auto
# Set false if mesh nodes don't accept SSH with the same key.
MESH_SSH=true
FAST_INTERVAL=15
SLOW_INTERVAL=300
LOG_LEVEL=INFO
# Devices not seen for this many days are forgotten (online/last-seen series stop).
CLIENT_RETENTION_DAYS=30
# Device names/owners/types and offline alerts: config/collector/devices.yml (see the .example).
# MAC vendor names: run scripts/update-oui.sh once.

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
# Where your browser reaches NetAlertX (used for a dashboard link).
NETALERTX_URL=http://192.168.50.10:20211

# --- Speedtest Tracker ---
# Generate with: echo "base64:$(openssl rand -base64 32)"
SPEEDTEST_APP_KEY=
SPEEDTEST_APP_URL=http://192.168.50.10:18765
# Cron format. Default: every 2 hours at :17.
SPEEDTEST_SCHEDULE=17 */2 * * *

# --- Ports published on the host ---
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
SPEEDTEST_PORT=18765

# --- Storage ---
PROMETHEUS_RETENTION=365d

# Optional services to start. Remove "netalertx" to skip device discovery.
COMPOSE_PROFILES=netalertx
