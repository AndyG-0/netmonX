    {
      "type": "table",
      "title": "Radios",
      "description": "From `wl chanspec`, `wl noise` and `wl chanim_stats` on each node. DFS channels (5 GHz 52-144) must move when the radio detects radar. Busy is 100 minus the driver's idle airtime share.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "asus_wifi_radio_info{node=~\"$node\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "asus_wifi_channel_width_mhz{node=~\"$node\"}",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "asus_wifi_noise_dbm{node=~\"$node\"}",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 - asus_wifi_airtime_percent{node=~\"$node\", stat=\"idle\"}",
          "legendFormat": "",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(asus_wifi_channel_changes_total{node=~\"$node\"}[24h])",
          "legendFormat": "",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "Value #A": true,
              "stat": true
            },
            "renameByName": {
              "node": "Node",
              "iface": "Interface",
              "radio": "Radio",
              "band": "Band",
              "chanspec": "Channel",
              "dfs": "DFS",
              "Value #B": "Width",
              "Value #C": "Noise floor",
              "Value #D": "Busy",
              "Value #E": "Channel changes (24h)"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Width"
            },
            "properties": [
              {
                "id": "unit",
                "value": "MHz"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Noise floor"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dBm"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Busy"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "green"
                    },
                    {
                      "value": 50,
                      "color": "yellow"
                    },
                    {
                      "value": 75,
                      "color": "red"
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "DFS"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "no"
                      },
                      "1": {
                        "text": "yes",
                        "color": "orange"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Channel changes (24h)"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Node",
            "desc": false
          }
        ]
      },
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 7
      }
