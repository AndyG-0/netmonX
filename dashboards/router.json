    {
      "type": "timeseries",
      "title": "Airtime busy",
      "description": "Share of time the channel was not idle: our traffic, other networks and non-Wi-Fi noise.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
