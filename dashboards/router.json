    {
      "type": "timeseries",
      "title": "Interface traffic",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(asus_net_receive_bytes_total{node=~\"$node\", iface=~\"$iface\"}[$__rate_interval]) * 8",
          "legendFormat": "{{node}} {{iface}} in",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(asus_net_transmit_bytes_total{node=~\"$node\", iface=~\"$iface\"}[$__rate_interval]) * -8",
          "legendFormat": "{{node}} {{iface}} out",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never",
