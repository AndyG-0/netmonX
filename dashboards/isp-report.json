{
  "uid": "netmonx-isp-report",
  "title": "ISP report card",
  "tags": [
    "netmonx"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "netmonX",
      "type": "dashboards",
      "tags": [
        "netmonx"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "NetAlertX",
      "type": "link",
      "url": "http://192.168.50.10:20211",
      "targetBlank": true,
      "icon": "external link"
    },
    {
      "title": "Speedtest Tracker",
      "type": "link",
      "url": "http://192.168.50.10:18765",
      "targetBlank": true,
      "icon": "external link"
    }
