        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ceil(changes((max(asus_wan_up))[$__range:1m]) / 2)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
