    {
      "type": "table",
      "title": "All devices",
      "description": "One row per device. Filter a column with the funnel icon in its header. Counts come from the main router's AiMesh client list, so every node is included.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "asus_client_info",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "asus_client_rssi_dbm * on (mac) group_left (ip) asus_client_info",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "node": true,
              "Value #A": true
            },
            "renameByName": {
              "hostname": "Name",
              "mac": "MAC",
              "ip": "IP",
              "node_name": "Mesh node",
              "connection": "Connection",
              "band": "Band",
              "ssid": "SSID",
              "Value #B": "Signal"
            },
            "indexByName": {
              "Name": 0,
              "IP": 1,
              "Mesh node": 2,
              "Connection": 3,
              "Band": 4,
              "SSID": 5,
              "Signal": 6,
              "MAC": 7
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Signal"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dBm"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "red"
                    },
                    {
                      "value": -75,
                      "color": "orange"
                    },
                    {
                      "value": -67,
                      "color": "yellow"
                    },
                    {
                      "value": -55,
                      "color": "green"
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Mesh node",
            "desc": false
          }
        ]
      },
