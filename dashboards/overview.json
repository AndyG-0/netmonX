    {
      "type": "timeseries",
      "title": "Internet latency: router vs. LAN",
      "description": "Router pings leave out your Wi-Fi and LAN. If the LAN lines spike but the router lines don't, the problem is inside your home network.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "asus_ping_rtt_avg_ms{role=\"internet\"}",
          "legendFormat": "router \u2192 {{target}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "asus_ping_rtt_avg_ms{role=\"isp_gateway\"}",
          "legendFormat": "router \u2192 ISP gateway",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1000 * sum by (host) (rate(smokeping_response_duration_seconds_sum{host!~\"(10|192\\\\.168|172\\\\.(1[6-9]|2[0-9]|3[01]))\\\\..*\"}[$__rate_interval])) / sum by (host) (rate(smokeping_response_duration_seconds_count{host!~\"(10|192\\\\.168|172\\\\.(1[6-9]|2[0-9]|3[01]))\\\\..*\"}[$__rate_interval]))",
          "legendFormat": "LAN \u2192 {{host}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 14,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 16,
        "h": 9
      }
    },
