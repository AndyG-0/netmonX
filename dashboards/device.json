{
  "uid": "netmonx-device",
  "title": "Device",
  "tags": [
    "netmonx"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "mac",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "query_result(max by (hostname, mac) (asus_client_online{hostname!=\"\"}) or label_replace(max by (hostname, mac) (asus_client_online{hostname=\"\"}), \"hostname\", \"unnamed $1\", \"mac\", \"(.*)\"))",
          "refId": "v"
        },
        "definition": "query_result(max by (hostname, mac) (asus_client_online{hostname!=\"\"}) or label_replace(max by (hostname, mac) (asus_client_online{hostname=\"\"}), \"hostname\", \"unnamed $1\", \"mac\", \"(.*)\"))",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "sort": 5,
        "current": {},
        "regex": "/hostname=\"(?<text>[^\"]*)\",\\s*mac=\"(?<value>[^\"]*)\"/"
      }
    ]
  },
  "links": [
    {
      "title": "netmonX",
      "type": "dashboards",
      "tags": [
        "netmonx"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "NetAlertX",
