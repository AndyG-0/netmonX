    {
      "type": "heatmap",
      "title": "LAN latency distribution: $host",
      "description": "SmokePing-style view. A tight band is good; smear or speckle above it means jitter.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (le) (increase(smokeping_response_duration_seconds_bucket{host=\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{le}}",
          "refId": "A",
          "format": "heatmap"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "s"
        },
        "color": {
          "mode": "scheme",
          "scheme": "Spectral",
          "reverse": true,
          "exponent": 0.5
        },
        "cellGap": 0,
        "tooltip": {
          "mode": "single",
          "yHistogram": true
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 10
      }
    },
