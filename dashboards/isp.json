    {
      "type": "stat",
      "title": "Bufferbloat",
      "description": "Extra latency under load in the last speed test (worse of download and upload, minus idle ping). Graded like Waveform's bufferbloat test: A+ up to 5 ms, A 30, B 60, C 200, D 400, F above. B or worse means calls and games stutter while someone downloads; turning on QoS / Smart Queue (Adaptive QoS on Asus) usually fixes it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_min((max(speedtest_tracker_download_latency_iqm_ms) > max(speedtest_tracker_upload_latency_iqm_ms) or max(speedtest_tracker_upload_latency_iqm_ms)) - max(speedtest_tracker_ping_ms), 0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 5,
                "result": {
                  "text": "A+",
                  "color": "green"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 5,
                "to": 30,
                "result": {
                  "text": "A",
                  "color": "green"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 30,
                "to": 60,
                "result": {
                  "text": "B",
                  "color": "yellow"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 60,
                "to": 200,
                "result": {
                  "text": "C",
                  "color": "orange"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 200,
                "to": 400,
                "result": {
                  "text": "D",
                  "color": "red"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 400,
                "to": 1000000000.0,
                "result": {
                  "text": "F",
                  "color": "dark-red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "id": 9,
      "gridPos": {
        "x": 20,
        "y": 20,
        "w": 4,
        "h": 8
      }
