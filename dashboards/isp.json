    {
      "type": "timeseries",
      "title": "Speed test latency",
      "description": "A big rise under load points to bufferbloat.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(speedtest_tracker_ping_ms)",
          "legendFormat": "idle ping",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(speedtest_tracker_download_latency_iqm_ms)",
          "legendFormat": "loaded: download (IQM)",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(speedtest_tracker_upload_latency_iqm_ms)",
          "legendFormat": "loaded: upload (IQM)",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_min((max(speedtest_tracker_download_latency_iqm_ms) > max(speedtest_tracker_upload_latency_iqm_ms) or max(speedtest_tracker_upload_latency_iqm_ms)) - max(speedtest_tracker_ping_ms), 0)",
          "legendFormat": "added under load",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
