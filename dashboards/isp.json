      "description": "Hops that never answer are left out. Loss at one hop that later hops don't show is just that router ignoring traceroute; loss that carries on to the last hop is real.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
