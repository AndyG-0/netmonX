          "expr": "asus_traceroute_hop_loss_ratio",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "node": true,
              "node_name": true
            },
            "renameByName": {
              "hop": "Hop",
              "ip": "Address",
              "Value #A": "RTT (ms)",
              "Value #B": "Loss"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
