    {
      "type": "timeseries",
      "title": "Long-run loss rate (router)",
      "description": "Share of pings lost over the past hour, per target.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - rate(asus_ping_packets_received_total[1h]) / rate(asus_ping_packets_sent_total[1h])",
          "legendFormat": "{{target}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
