        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "asus_traceroute_hop_rtt_ms",
          "legendFormat": "",
          "refId": "A",
