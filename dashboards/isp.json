{
  "uid": "netmonx-isp",
  "title": "ISP & Internet",
  "tags": [
    "netmonx"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "LAN ping target",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(smokeping_response_duration_seconds_count, host)",
          "refId": "v"
        },
        "definition": "label_values(smokeping_response_duration_seconds_count, host)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "sort": 1,
        "current": {}
      }
    ]
  },
  "links": [
    {
      "title": "netmonX",
      "type": "dashboards",
      "tags": [
        "netmonx"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "NetAlertX",
      "type": "link",
      "url": "http://192.168.50.10:20211",
      "targetBlank": true,
      "icon": "external link"
    },
    {
      "title": "Speedtest Tracker",
      "type": "link",
      "url": "http://192.168.50.10:18765",
      "targetBlank": true,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Latency",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "heatmap",
      "title": "LAN latency distribution: $host",
      "description": "SmokePing-style view. A tight band is good; smear or speckle above it means jitter.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (le) (increase(smokeping_response_duration_seconds_bucket{host=\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{le}}",
          "refId": "A",
          "format": "heatmap"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "s"
        },
        "color": {
          "mode": "scheme",
          "scheme": "Spectral",
          "reverse": true,
          "exponent": 0.5
        },
        "cellGap": 0,
        "tooltip": {
          "mode": "single",
          "yHistogram": true
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "timeseries",
      "title": "Router ping range (min / avg / max)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "asus_ping_rtt_min_ms{role!=\"\"}",
          "legendFormat": "min {{target}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "asus_ping_rtt_avg_ms{role!=\"\"}",
          "legendFormat": "avg {{target}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "asus_ping_rtt_max_ms{role!=\"\"}",
          "legendFormat": "max {{target}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 10
      }
    },
